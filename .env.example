# OpenBIM Hub API 配置（复制为 .env 或注入环境变量）

# 监听
HOST=127.0.0.1
PORT=3001

# 数据库：开发默认 SQLite（文件位于 DATA_DIR）。生产建议 PostgreSQL：
#   1) 将 apps/api/prisma/schema.prisma 的 provider 改为 "postgresql"
#   2) DATABASE_URL=postgresql://user:pass@host:5432/openbimhub
# DATABASE_URL=file:D:/data/openbim-hub/app.db

# 对象/文件存储根目录（BlobStore 本地实现）
DATA_DIR=./data

# 认证：生产必须设置为强随机值（openssl rand -base64 48）
JWT_SECRET=change-me-to-a-long-random-secret
# REFRESH_TOKEN_DAYS=30

# 上传限制（MB）
MAX_UPLOAD_MB=512

# 转换：worker（worker_threads 池，生产默认）| inline（单进程，调试用）
CONVERSION_MODE=worker
# 转换并发（默认 CPU/2，上限 8）
# CONCURRENCY=2

# 日志级别：trace|debug|info|warn|error
LOG_LEVEL=info
