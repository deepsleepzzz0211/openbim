{
  "name": "openbim-hub",
  "version": "0.1.0",
  "private": true,
  "description": "OpenBIM Hub — production-grade, self-hosted, open-source BIM collaboration platform (Apache-2.0)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "test:mutation": "pnpm --filter @openbim-hub/bcf --filter @openbim-hub/ifc run test:mutation",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "eslint": "^9.20.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "web-ifc",
      "@prisma/client",
      "prisma",
      "bcrypt",
      "bcryptjs"
    ]
  }
}
